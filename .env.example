# ----- Server configuration -----
PORT=4000
NODE_ENV=development

# JWT secret used to sign auth tokens (change in production!)
# In production (NODE_ENV=production) the server refuses to start if this is
# still the default value.
JWT_SECRET=super-secret-change-me

# SQLite database file location (inside the server container / process).
# In Docker this is overridden to /data/mtodo.sqlite (see docker-compose.yml).
DATABASE_FILE=./data/mtodo.sqlite

# ----- Security (optional) -----
# Comma-separated CORS allow-list. Leave empty to allow any origin — this is
# the default and keeps the app usable on plain HTTP LAN servers
# (e.g. http://192.168.1.10:5173) without extra configuration.
# ALLOWED_ORIGINS=http://localhost:5173,http://192.168.1.10:5173

# Trust X-Forwarded-* headers from a reverse proxy (nginx, traefik, ngrok).
# Enable when the API sits behind a proxy so rate limiting sees real client IPs.
# TRUST_PROXY=true

# Rate limiting (per IP). Defaults are generous for normal use.
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=600
# RATE_LIMIT_AUTH_MAX=30

# ----- Admin panel credentials -----
# These define the built-in administrator account.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345

# ----- Telegram integration (optional) -----
# Create a bot with @BotFather to get the token, then set the bot's username.
# Leave empty to disable the Telegram bot & "Login with Telegram".
# For the Login Widget to work, set the bot domain in BotFather (/setdomain).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# ----- Client configuration -----
# Base URL the client uses to reach the API.
VITE_API_URL=http://localhost:4000/api

# ----- Data persistence (Docker) -----
# Host folder the SQLite database is bind-mounted from (relative to the docker/
# folder, or an absolute path). The DB lives here as a real file on the host, so
# it survives image rebuilds, `docker compose down -v`, and volume pruning.
# Only deleting this folder loses your data.
# DATA_HOST_DIR=../data

# ----- Database backups (Docker) -----
# The `backup` service (docker/docker-compose.yml) takes a snapshot on startup
# and then daily at BACKUP_TIME (HH:MM, 24h, UTC).
# BACKUP_TIME=03:00
# Number of days of backups to keep before old ones are pruned.
# BACKUP_RETENTION_DAYS=7
# Host folder the gzipped backups are copied to (relative to the docker/ folder).
# BACKUP_HOST_DIR=../backups

# ----- ngrok tunnel (optional, Docker) -----
# Auth token for the `ngrok` service in docker/docker-compose.yml.
# Get one at https://dashboard.ngrok.com. Leave empty to skip the tunnel.
NGROK_AUTHTOKEN=
